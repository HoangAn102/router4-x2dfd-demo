# ============================================================
# ROUTER4 x X2DFD WEB APPLICATION ENVIRONMENT CONFIGURATION
# ============================================================

# Execution Mode: "mock" (Local dev/test without GPU) or "live" (Production on GPU server)
RUN_MODE=mock
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Media Limits
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SEC=60
MAX_IMAGE_DIMENSION=4096

# Multi-Tier Timeouts (in seconds)
IMAGE_INFERENCE_TIMEOUT_SEC=60
FRAME_INFERENCE_TIMEOUT_SEC=45
VIDEO_TOTAL_TIMEOUT_SEC=300

# Concurrency & GPU settings
MAX_CONCURRENT_GPU_TASKS=1
GPU_LOCK_FILE=gpu.lock
TEMP_CLEANUP_MAX_AGE_HOURS=1
JOB_TTL_SECONDS=900

# Research Server Paths (Active when RUN_MODE=live)
ROUTER_CHECKPOINT=/home/aiotlab/hoangan/outputs/ROUTER4_FINAL_CLEAN_RETRAIN_20260919/02_router/final_checkpoint/best.pt
CALIBRATORS_PATH=/home/aiotlab/hoangan/outputs/ROUTER4_FINAL_CLEAN_RETRAIN_20260919/01_teacher/calibrators_FINAL_CLEAN.joblib
ROUTER4_LORA_DIR=/home/aiotlab/hoangan/outputs/ROUTER4_FINAL_CLEAN_RETRAIN_20260919/05_lora/router4_x2dfd_FINAL_CLEAN
BASE_LLAVA_DIR=/home/aiotlab/hoangan/projects/X2DFD/weights/base/llava-v1.5-7b

# Runtime Conda Wrappers (Active when RUN_MODE=live)
X2PYTHON_BIN=/home/aiotlab/hoangan/outputs/ROUTER4_FINAL_CLEAN_RETRAIN_20260919/06_crossdata_benchmark/PAPER_FINAL_2CROSS_CDF_DFDCP/runtime_clean_v2/x2python
FREQPYTHON_BIN=/home/aiotlab/hoangan/outputs/ROUTER4_FINAL_CLEAN_RETRAIN_20260919/06_crossdata_benchmark/PAPER_FINAL_2CROSS_CDF_DFDCP/runtime_clean_v2/freqpython
TEXPYTHON_BIN=/home/aiotlab/hoangan/outputs/ROUTER4_FINAL_CLEAN_RETRAIN_20260919/06_crossdata_benchmark/PAPER_FINAL_2CROSS_CDF_DFDCP/runtime_clean_v2/texpython
